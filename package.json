{
  "name": "bottleimp",
  "version": "0.1.0",
  "private": true,
  "description": "The Bottle Imp — online multiplayer trick-taking game (fan implementation)",
  "type": "module",
  "scripts": {
    "server": "tsx watch server/index.ts",
    "build:server": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "client": "cd client && npm run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit && cd client && npm run typecheck",
    "test": "vitest run",
    "build": "npm run build:server && cd client && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
